# Keep sources and scripts LF in the repo. The shell scripts and Python here are
# executed inside WSL; a CRLF checkout makes bash fail with "$'\r': command not
# found", and git on Windows would otherwise convert them on checkout.
* text=auto

*.sh   text eol=lf
*.py   text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.md   text eol=lf
*.csv  text eol=lf

# Binary artifacts: never touch.
*.exe  binary
*.obj  binary
*.pdb  binary
*.xlsx binary
*.vtune binary
